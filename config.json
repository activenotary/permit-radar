{
  "db_path": "permits.db",
  "lookback_days": 7,
  "enrich": {
    "model": "claude-haiku-4-5",
    "batch_size": 20,
    "max_permits_per_run": 400
  },
  "cities": {
    "chicago": {
      "label": "Chicago, IL",
      "domain": "data.cityofchicago.org",
      "dataset": "ydr8-5enu",
      "issued_field": "issue_date",
      "extra_where": "reported_cost > '25000'",
      "fields": {
        "permit_id": "permit_",
        "permit_type": "permit_type",
        "description": "work_description",
        "value": "reported_cost",
        "contractor": "contact_1_name",
        "lat": "latitude",
        "lon": "longitude"
      },
      "address_fields": ["street_number", "street_direction", "street_name"]
    },
    "austin": {
      "label": "Austin, TX",
      "dataset": "3syk-w9eu",
      "domain": "data.austintexas.gov",
      "issued_field": "issue_date",
      "extra_where": "permit_class_mapped = 'Commercial'",
      "fields": {
        "permit_id": "permit_number",
        "permit_type": "permit_type_desc",
        "description": "description",
        "value": "total_job_valuation",
        "contractor": "contractor_company_name",
        "lat": "latitude",
        "lon": "longitude"
      },
      "address_fields": ["original_address1", "original_city"]
    },
    "losangeles": {
      "label": "Los Angeles, CA",
      "domain": "data.lacity.org",
      "dataset": "pi9x-tg5x",
      "lookback_days": 30,
      "issued_field": "issue_date",
      "extra_where": "permit_sub_type = 'Commercial'",
      "fields": {
        "permit_id": "permit_nbr",
        "permit_type": "permit_type",
        "description": "work_desc",
        "value": "valuation",
        "lat": "lat",
        "lon": "lon"
      },
      "address_fields": ["primary_address", "zip_code"]
    },
    "lasvegas": {
      "label": "Las Vegas, NV",
      "api": "arcgis",
      "endpoint": "https://services1.arcgis.com/F1v0ufATbBQScMtY/arcgis/rest/services/OpenData_Building_Permits_/FeatureServer/0/query",
      "issued_field": "ISSDTTM",
      "extra_where": "COMM = 'Y'",
      "lookback_days": 14,
      "fields": {
        "permit_id": "APNO",
        "permit_type": "WORKTYPE",
        "description": "WORKTYPE",
        "value": "DECLVLTN",
        "contractor": "APPLICANT"
      },
      "address_fields": ["STNO", "PREDIR", "STNAME", "SUFFIX", "CITY", "ZIP"]
    },
    "riverside": {
      "label": "Riverside, CA",
      "api": "riverside",
      "endpoint": "https://riversideca.gov/transparency/data/dataset/json/34",
      "issued_field": "Issue Date",
      "lookback_days": 14,
      "prefixes": ["BP"],
      "fields": {
        "permit_id": "Permit Number",
        "permit_type": "Permit Sub-Type",
        "description": "Description",
        "value": "Valuation",
        "contractor": "Contractor Name"
      },
      "address_fields": ["Site Address"]
    },
    "tucson": {
      "label": "Tucson, AZ",
      "api": "arcgis",
      "endpoint": "https://gis.tucsonaz.gov/public/rest/services/PublicMaps/PermitsCode/MapServer/81/query",
      "issued_field": "ISSUEDATE",
      "lookback_days": 14,
      "fields": {
        "permit_id": "NUMBER",
        "permit_type": "WORKCLASS",
        "description": "DESCRIPTION",
        "value": "VALUE"
      },
      "address_fields": ["ADDRESS", "CITY", "POSTALCODE"]
    },
    "miami": {
      "label": "Miami-Dade, FL",
      "api": "arcgis",
      "endpoint": "https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/arcgis/rest/services/miamidade_permit_data/FeatureServer/0/query",
      "issued_field": "PermitIssuedDate",
      "extra_where": "ResidentialCommercial='C'",
      "fields": {
        "permit_id": "PermitNumber",
        "permit_type": "PermitType",
        "description": "DetailDescriptionComments",
        "value": "EstimatedValue",
        "contractor": "ContractorName"
      },
      "address_fields": ["PropertyAddress"]
    },
    "neworleans": {
      "label": "New Orleans, LA",
      "domain": "data.nola.gov",
      "dataset": "72f9-bi28",
      "issued_field": "issuedate",
      "extra_where": "permitclassmapped='Non-Residential'",
      "fields": {
        "permit_id": "permitnum",
        "permit_type": "permittypedesc",
        "description": "description",
        "value": "estprojectcost",
        "contractor": "contractorcompanyname"
      },
      "address_fields": ["originaladdress1", "originalcity"]
    },
    "nashville": {
      "label": "Nashville, TN",
      "api": "arcgis",
      "endpoint": "https://services2.arcgis.com/HdTo6HJqh92wn4D8/arcgis/rest/services/Building_Permits_Issued_2/FeatureServer/0/query",
      "issued_field": "Date_Issued",
      "extra_where": "Permit_Type_Description LIKE '%Comm%'",
      "fields": {
        "permit_id": "Permit__",
        "permit_type": "Permit_Type_Description",
        "description": "Purpose",
        "value": "Const_Cost",
        "contractor": "Contact"
      },
      "address_fields": ["Address", "City", "ZIP"]
    },
    "sanfrancisco": {
      "label": "San Francisco, CA",
      "domain": "data.sfgov.org",
      "dataset": "i98e-djp9",
      "issued_field": "issued_date",
      "extra_where": "proposed_use not like '%family%' AND proposed_use != 'apartments'",
      "fields": {
        "permit_id": "permit_number",
        "permit_type": "permit_type_definition",
        "description": "description",
        "value": "estimated_cost"
      },
      "address_fields": ["street_number", "street_name", "street_suffix"]
    },
    "denver": {
      "label": "Denver, CO",
      "api": "arcgis",
      "endpoint": "https://services1.arcgis.com/zdB7qR0BtYrg0Xpl/arcgis/rest/services/ODC_DEV_COMMERCIALCONSTPERMIT_P/FeatureServer/317/query",
      "issued_field": "DATE_ISSUED",
      "fields": {
        "permit_id": "PERMIT_NUM",
        "permit_type": "CLASS",
        "description": "CLASS",
        "value": "VALUATION",
        "contractor": "CONTRACTOR_NAME"
      },
      "address_fields": ["ADDRESS"]
    },
    "henderson": {
      "label": "Henderson, NV",
      "api": "arcgis",
      "endpoint": "https://maps.cityofhenderson.com/arcgis/rest/services/public/OpenDevPermits/MapServer/2/query",
      "issued_field": "ISSUEDATE",
      "lookback_days": 14,
      "fields": {
        "permit_id": "CASENUMBER",
        "permit_type": "CASETYPE",
        "description": "DESCRIPTION"
      },
      "address_fields": ["MAIN_ADDRESS_LINE1", "MAIN_ADDRESS_LINE2"]
    },
    "newyork": {
      "label": "New York City, NY",
      "domain": "data.cityofnewyork.us",
      "dataset": "rbx6-tga4",
      "issued_field": "issued_date",
      "extra_where": "estimated_job_costs::number > 25000",
      "fields": {
        "permit_id": "work_permit",
        "permit_type": "work_type",
        "description": "job_description",
        "value": "estimated_job_costs",
        "contractor": "applicant_business_name"
      },
      "address_fields": ["house_no", "street_name", "borough", "zip_code"]
    },
    "seattle": {
      "label": "Seattle, WA",
      "domain": "data.seattle.gov",
      "dataset": "76t5-zqzr",
      "issued_field": "issueddate",
      "extra_where": "permitclassmapped='Non-Residential'",
      "lookback_days": 14,
      "fields": {
        "permit_id": "permitnum",
        "permit_type": "permittypedesc",
        "description": "description",
        "value": "estprojectcost"
      },
      "address_fields": ["originaladdress1", "originalcity"]
    },
    "philadelphia": {
      "label": "Philadelphia, PA",
      "api": "carto",
      "domain": "phl.carto.com",
      "table": "permits",
      "issued_field": "permitissuedate",
      "extra_where": "commercialorresidential='Commercial'",
      "fields": {
        "permit_id": "permitnumber",
        "permit_type": "typeofwork",
        "description": "approvedscopeofwork",
        "contractor": "contractorname"
      },
      "address_fields": ["address", "zip"]
    },
    "anaheim": {
      "label": "Anaheim, CA",
      "api": "arcgis",
      "endpoint": "https://services3.arcgis.com/hPs600I3X0RTaaaq/arcgis/rest/services/Accela_Building_Permits/FeatureServer/0/query",
      "issued_field": "permitissued",
      "extra_where": "comres LIKE 'Commercial%'",
      "lookback_days": 14,
      "fields": {
        "permit_id": "casenumber",
        "permit_type": "typeofwork",
        "description": "description",
        "value": "jobvaluation",
        "contractor": "contractorsname"
      },
      "address_fields": ["address"]
    },
    "sacramento": {
      "label": "Sacramento County, CA",
      "api": "arcgis",
      "endpoint": "https://services1.arcgis.com/5NARefyPVtAeuJPU/arcgis/rest/services/Permits/FeatureServer/0/query",
      "issued_field": "ISSUED_DATE",
      "extra_where": "Application_Type='Commercial'",
      "lookback_days": 14,
      "fields": {
        "permit_id": "Application",
        "permit_type": "Application_Subtype",
        "description": "WorkDescription",
        "value": "Valuation",
        "contractor": "Contractor"
      },
      "address_fields": ["Address"]
    },
    "sanjose": {
      "label": "San Jose, CA",
      "api": "csv",
      "url": "https://data.sanjoseca.gov/dataset/2723cdec-a639-4b63-bded-175338c45473/resource/045b3678-e923-4002-b696-300955bc6d06/download/buildingpermits30.csv",
      "issued_field": "ISSUEDATE",
      "equals": {"FOLDERDESC": "Commercial/Industrial"},
      "lookback_days": 14,
      "fields": {
        "permit_id": "FOLDERNUMBER",
        "permit_type": "SUBTYPEDESCRIPTION",
        "description": "WORKDESCRIPTION",
        "value": "PERMITVALUATION",
        "contractor": "CONTRACTOR"
      },
      "address_fields": ["gx_location"]
    },
    "sandiego": {
      "label": "San Diego, CA",
      "api": "csv",
      "url": "https://seshat.datasd.org/development_permits_set2/permits_set2_active_datasd.csv",
      "issued_field": "date_approval_issue",
      "equals": {"approval_status": "Issued"},
      "lookback_days": 14,
      "fields": {
        "permit_id": "approval_id",
        "permit_type": "approval_type",
        "description": "approval_scope",
        "contractor": "approval_permit_holder"
      },
      "address_fields": ["address_job"]
    }
  }
}
